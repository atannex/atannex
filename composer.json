{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework",
        "atannex",
        "lebialem",
        "fontem",
        "alou",
        "wabane",
        "lewoh",
        "ndungated",
        "nwametaw",
        "nwangong",
        "m'mouck-mbie",
        "m'mouck-ngie",
        "lebang",
        "essoh-attah",
        "njogwi",
        "bamumbu",
        "bangang",
        "banti",
        "bechati",
        "besali",
        "folepi",
        "igumbo",
        "nkong"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bensampo/laravel-enum": "^6.12",
        "doctrine/dbal": "^4.4",
        "filament/filament": "^4.0",
        "geoip2/geoip2": "^3.2",
        "jenssegers/agent": "^2.6",
        "jorenvanhocht/laravel-share": "^4.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "livewire/livewire": "^3.6",
        "mews/purifier": "^3.4",
        "spatie/laravel-permission": "^6.21",
        "spatie/laravel-sluggable": "^3.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "files": [
            "morfaw/Helpers/CategoryHelper.php",
            "morfaw/Helpers/SeoHelper.php",
            "morfaw/Helpers/PostHelper.php",
            "morfaw/Helpers/NumberHelper.php",
            "morfaw/Helpers/GuestUiHelper.php",
            "morfaw/Traits/CanNormalize.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Atannex\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sql') || touch('database/database.sql');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
