###############################################################################
# 🌐 Apache Rewrite & Routing Configuration for Laravel (HostGator Shared)
###############################################################################

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    ###########################################################################
    # 🔒 Prevent direct access to `/public` folder
    ###########################################################################
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+public/([^\s]+)? [NC]
    RewriteRule ^ /%1 [R=301,L,NC]

    ###########################################################################
    # ⚠️ HTTPS redirection disabled for HostGator shared hosting
    # Use cPanel redirects or Laravel middleware for HTTPS enforcement
    ###########################################################################
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    ###########################################################################
    # 📦 Laravel Routing: Send all non-file requests to public/index.php
    ###########################################################################
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php [QSA,L]

    ###########################################################################
    # 🏠 Route root requests explicitly
    ###########################################################################
    RewriteRule ^$ public/index.php [L]
</IfModule>

###############################################################################
# 🚫 Disable directory listing
###############################################################################
Options -Indexes

###############################################################################
# ✅ Default index files
###############################################################################
DirectoryIndex index.php index.html

###############################################################################
# 🔐 Block access to hidden files and Laravel internals
###############################################################################
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block direct access to sensitive directories
RedirectMatch 403 ^/(vendor|storage|bootstrap|resources)/.*$

###############################################################################
# ⚠️ Block PHP execution in user-uploaded folders
# Remove or customize this for your setup - <Directory> is not allowed in .htaccess on shared hosting
###############################################################################
# <Directory "/path/to/storage">
#     <FilesMatch "\.(php|php5|phtml)$">
#         Order allow,deny
#         Deny from all
#     </FilesMatch>
# </Directory>

###############################################################################
